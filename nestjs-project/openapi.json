            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Download a video",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "new_password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "new_password"
        ]
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "description": "Original file name, e.g. `aula.mp4`.",
            "minLength": 1,
            "maxLength": 255
          },
          "fileSize": {
            "type": "number",
            "description": "File size in bytes (max 10 GiB).",
            "minimum": 1,
            "maximum": 10737418240
          },
          "contentType": {
            "type": "string",
            "description": "MIME type of the file; must be a video type (e.g. `video/mp4`).",
            "pattern": "^video\\/[\\w.+-]+$"
          },
          "title": {
            "type": "string",
            "description": "Video title; defaults to the file name without its extension.",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "fileName",
          "fileSize",
          "contentType"
        ]
      },
      "PresignedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned S3 UploadPart URL — PUT the part bytes to it.",
            "example": "http://localhost:9000/streamtube/videos/0b3c.../original?partNumber=1&uploadId=...&X-Amz-Signature=..."
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "title": {
            "type": "string",
            "example": "aula"
          },
          "status": {
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "type": "string",
            "example": "draft"
          },
          "uploadId": {
            "type": "string",
            "description": "S3 multipart upload id"
          },
          "partSize": {
            "type": "number",
            "example": 104857600,
            "description": "Part size in bytes"
          },
          "partCount": {
            "type": "number",
            "example": 3
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedPartDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "uploadId",
          "partSize",
          "partCount",
          "parts",
          "expiresAt"
        ]
      },
      "UploadPartsDto": {
        "type": "object",
        "properties": {
          "partNumbers": {
            "description": "Part numbers (1-based) whose upload URLs should be re-signed.",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "required": [
          "partNumbers"
        ]
      },
      "UploadPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedPartDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "parts",
          "expiresAt"
        ]
      },
      "CompletedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "description": "1-based part number.",
            "minimum": 1,
            "maximum": 10000
          },
          "etag": {
            "type": "string",
            "description": "ETag header returned by object storage for the part PUT."
          }
        },
        "required": [
          "partNumber",
          "etag"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "description": "Every uploaded part with its ETag (part numbers 1..partCount).",
            "minItems": 1,
            "maxItems": 10000,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompletedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "status": {
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "type": "string",
            "example": "processing"
          }
        },
        "required": [
          "id",
          "slug",
          "status"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "formatName": {
            "type": "string",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bitRate": {
            "type": "number",
            "nullable": true,
            "example": 1048576
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "videoCodec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audioCodec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          }
        },
        "required": [
          "formatName",
          "bitRate",
          "width",
          "height",
          "videoCodec",
          "audioCodec"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "title": {
            "type": "string",
            "example": "aula"
          },
          "status": {
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "type": "string"
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true,
            "example": 212.48
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "sizeBytes": {
            "type": "string",
            "example": "314572800",
            "description": "File size in bytes (bigint as decimal string)"
          },
          "contentType": {
            "type": "string",
            "example": "video/mp4"
          },
          "channelId": {
            "type": "string",
            "format": "uuid"
          },
          "streamUrl": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/stream"
          },
          "downloadUrl": {
            "type": "string",
            "example": "/videos/dQw4w9WgXcQ/download"
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "example": "/videos/dQw4w9WgXcQ/thumbnail",
            "description": "Present only when the video is ready"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "durationSeconds",
          "metadata",
          "sizeBytes",
          "contentType",
          "channelId",
          "streamUrl",
          "downloadUrl",
          "thumbnailUrl",
          "createdAt"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}